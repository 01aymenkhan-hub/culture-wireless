# -----------------------------------------------------------------------------
# Culture Wireless — environment variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local (see .gitignore).
# -----------------------------------------------------------------------------

# ----- Clerk authentication -----
# Get these from the Clerk Dashboard. The secret key must never be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ----- Google Maps / Places (client, exposed to the browser) -----
# Get a key from https://console.cloud.google.com/apis/credentials
# Restrict by HTTP referrer/domain before going to production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----- eBOSS / Fiber availability API (server-only) -----
# See: referenceFiles/EBOSS Documentation.pdf
EBOSS_API_KEY=
EBOSS_BASE_URL=https://www.efiberboss.com
EBOSS_CARRIER=Culture Wireless

# ----- CoverageMap 5G / 4G signal strength API (server-only) -----
# See: referenceFiles/coverage-api-guide.md
COVERAGE_API_KEY=
COVERAGE_API_URL=https://enterprise.coveragemap.com/api/v1

# ----- Telgoo5 (mobile availability / order provisioning, server-only) -----
# Not currently used. Set FEATURE_TELGOO5=true once credentials are provisioned.
FEATURE_TELGOO5=false
TELGOO5_BASE_URL=
TELGOO5_AGENT_ID=

# ----- Zoho (CRM / Billing, server-only) -----
# Not currently wired. lib/api/zoho.js exposes a scalable stub for future integrations.
FEATURE_ZOHO=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# ----- Support form (server-only Make.com webhook) -----
# Leave blank in development — form will short-circuit into a friendly no-op.
MAKE_SUPPORT_WEBHOOK_URL=

# ----- Feature flags -----
# When true, the availability APIs may fall back to deterministic mock data.
ENABLE_AVAILABILITY_MOCKS=false

# ----- MongoDB (server-only) -----
MONGODB_URI=
